  steps:
  - step: 1
    title: "\uACE0\uBBFC \uC801\uAE30"
    companionMessage: "\uBA3C\uC800 \uAC71\uC815\uC744 \uD654\uC774\uD2B8\uBCF4\uB4DC
      \uC704\uC5D0 \uAEBC\uB0B4\uBCFC\uAC8C\uC694."
    primaryActionLabel: "\uB2E4\uC74C"
    secondaryActionLabel: "\uCDE8\uC18C"
  - step: 2
    title: "\uC0AC\uC2E4\uACFC \uCD94\uCE21 \uB098\uB204\uAE30"
    companionMessage: "\uBD88\uC548\uC744 \uBC14\uB85C \uD574\uACB0\uD558\uB824 \uD558\uAE30
      \uC804\uC5D0, \uD655\uC2E4\uD55C \uC0AC\uC2E4\uACFC \uB0B4\uAC00 \uBD99\uC778
      \uD574\uC11D\uC744 \uB098\uB220\uBCFC\uAC8C\uC694."
    primaryActionLabel: "\uB2E4\uC74C"
    secondaryActionLabel: "\uC774\uC804"
  - step: 3
    title: "\uC0DD\uAC01 \uC810\uAC80\uD558\uAE30"
    companionMessage: "\uADF8 \uC0DD\uAC01\uC744 \uBBFF\uAC8C \uB9CC\uB4DC\uB294
      \uADFC\uAC70\uC640 \uBC18\uB300 \uADFC\uAC70\uB97C \uD568\uAED8 \uC0B4\uD3B4\uBD10\uC694."
    primaryActionLabel: "\uB2E4\uC74C"
    secondaryActionLabel: "\uC774\uC804"
  - step: 4
    title: "\uC9C0\uAE08 \uD560 \uC218 \uC788\uB294 \uD589\uB3D9 \uC815\uD558\uAE30"
    companionMessage: "\uC0DD\uAC01\uC744 \uBD99\uC7A1\uACE0 \uC788\uAE30\uBCF4\uB2E4
      \uC9C0\uAE08 \uD560 \uC218 \uC788\uB294 \uC791\uACE0 \uBD84\uBA85\uD55C \uD589\uB3D9\uC744
      \uC815\uD574\uC694."
    primaryActionLabel: "\uB2E4\uC74C"
    secondaryActionLabel: "\uC774\uC804"
  - step: 5
    title: "\uD55C \uC904\uB85C \uC815\uB9AC\uD558\uAE30"
    companionMessage: "\uC624\uB298\uC758 \uACB0\uB860\uC744 \uC2A4\uC2A4\uB85C\uC5D0\uAC8C
      \uB9D0\uD558\uB4EF \uD55C \uC904\uB85C \uB0A8\uACA8\uC694."
    primaryActionLabel: "\uB2E4\uC74C"
    secondaryActionLabel: "\uC774\uC804"
  - step: 6
    title: "\uB9C8\uC74C \uC0C1\uD0DC \uD655\uC778\uD558\uAE30"
    companionMessage: "\uC0DD\uAC01\uC744 \uC815\uB9AC\uD55C \uB4A4 \uC9C0\uAE08
      \uB9C8\uC74C\uC774 \uC5B4\uB5A4\uC9C0 \uD45C\uC2DC\uD574\uC694."
    primaryActionLabel: "\uC800\uC7A5"
    secondaryActionLabel: "\uC774\uC804"
